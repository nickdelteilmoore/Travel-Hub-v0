# Public client config — safe to ship in the APK (the anon key is RLS-gated).
# Copy to .env and fill in from your Supabase project settings → API.
# EAS cloud builds read these from EAS environment variables instead
# (eas env:create --environment preview); the GitHub Actions workflow reads
# them from the repository's Actions secrets of the same name.
#
# Never put a service-role key, or any other secret, in an EXPO_PUBLIC_ variable:
# everything with that prefix is compiled into the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
